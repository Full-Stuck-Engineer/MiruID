# =============================================================================
# MiruID Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Application environment (development | staging | production)
APP_ENV=development

# Application version reported by health/metadata endpoints
APP_VERSION=0.1.0

# Logging verbosity (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# OpenAI-compatible or local Ollama LLM endpoint
LLM_BASE_URL=http://localhost:11434/v1

# API key for the configured LLM provider (leave empty for local Ollama)
LLM_API_KEY=

# Model identifier used for structured extraction / vision tasks
LLM_MODEL=qwen2.5vl:7b

# Enable interactive API playground / debug endpoints (true | false)
ENABLE_PLAYGROUND=false

# =============================================================================
# Image Preprocessing & Quality Gate
# =============================================================================

# Minimum Laplacian variance blur score (also accepted as MIN_BLUR_SCORE)
BLUR_THRESHOLD=100.0

# Acceptable grayscale mean brightness range [0, 255]
MIN_BRIGHTNESS=40.0
MAX_BRIGHTNESS=220.0

# Maximum uploaded image payload size in megabytes
MAX_IMAGE_SIZE_MB=10

# Maximum image width or height in pixels before aspect-ratio-preserving downscale
MAX_IMAGE_DIM=1600

# Maximum ratio [0.0, 1.0] of near-white glare pixels (>= 250) before flagging glare
GLARE_PIXEL_RATIO_THRESHOLD=0.05

# Reject blurry images with ImageTooBlurryError when true
STRICT_QUALITY_GATE=true

# Apply LAB L-channel CLAHE contrast normalization when true
APPLY_CLAHE=true
