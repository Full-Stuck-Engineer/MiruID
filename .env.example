# =============================================================================
# MiruID Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Application environment (development | staging | production)
APP_ENV=development

# Application version reported by health/metadata endpoints
APP_VERSION=0.1.0

# Logging verbosity (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# OpenAI-compatible or local Ollama LLM endpoint
LLM_BASE_URL=http://localhost:11434/v1

# API key for the configured LLM provider (leave empty for local Ollama)
LLM_API_KEY=

# Model identifier used for structured extraction / vision tasks
LLM_MODEL=qwen2.5vl:7b

# Enable interactive API playground / debug endpoints (true | false)
ENABLE_PLAYGROUND=false
